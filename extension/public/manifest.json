{
  "manifest_version": 3,
  "name": "Prompt Improver",
  "version": "1.0.0",
  "description": "Optimize, score, template, and manage your AI prompts dynamically.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Prompt Improver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
